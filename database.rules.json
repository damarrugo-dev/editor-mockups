{
  "rules": {
    "presencia_mockups": {
      "$archivo": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/.*@(hitss|anava)[.]com$/i)",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true && auth.token.email.matches(/.*@(hitss|anava)[.]com$/i)"
        }
      }
    }
  }
}
